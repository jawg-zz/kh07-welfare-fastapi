# ============================================================
# KH07 Welfare Management System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Deployed apps (Dokploy) set these in Application > Environment.
# ============================================================

# ── Admin Credentials (used by seed.py on first run) ──
# These are the default login credentials baked into the Docker image.
# Change the password after first login via /admin/users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Telegram Notifications ──
# Used for contribution reminders and new cause alerts.
# Get a bot token from https://t.me/BotFather
# Get your chat ID from https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=7605394619:AAEdyytxWLLN6UVT_WFQSkcNgVPom-xFcYI
TELEGRAM_CHAT_ID=6760963523

# ── M-Pesa Daraja API (Safaricom) ──
# Required for STK Push (Lipa na M-Pesa) payments.
# Register at https://developer.safaricom.co.ke to get:
#   - Consumer Key
#   - Consumer Secret
#   - Passkey (from your Daraja app's "Lipa na M-Pesa Online" section)
# The shortcode is your PayBill/Till number.
#
# Sandbox defaults (test mode):
#   Shortcode: 174379
#   Passkey:    https://developer.safaricom.co.ke/test_credentials
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# Set to "false" when you have production M-Pesa credentials
MPESA_SANDBOX=true

# Public URL where the M-Pesa callback endpoint is reachable
# (Safaricom calls this after a successful STK Push)
MPESA_CALLBACK_URL=https://kh07-welfare.spidmax.win

# ── Database ──
# SQLite is the default (seeded at Docker build time).
# For PostgreSQL (optional), uncomment and set DATABASE_URL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/kh07_welfare
#
# SQLite path (used by the app — the DB is at /app/db.sqlite3 inside the container):
# DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# ── Application ──
# Session secret key — CHANGE THIS in production!
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=kh07-welfare-secret-key-change-me
